# AdSense Client ID for the web build (pata-skills-web.vercel.app) — same
# underlying Google Ads publisher account as the AdMob IDs above
# (5256043046254310), just the "ca-pub-" (web/AdSense) form instead of
# "ca-app-pub-" (in-app/AdMob). Read by app/+html.tsx to inject the
# verification/serving script into every static page's <head>.
EXPO_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5256043046254310

# AdSense ad-unit slot ID for the "watch an ad for +1 session" reward flow
# on web (WatchAdPromptSheet -> WatchingAdContent -> AdSenseDisplayUnit).
# NOT the same thing as the client ID above — this has to be created
# manually: AdSense dashboard -> Ads -> By ad unit -> Display ads ->
# Create, any responsive size works. Paste the resulting slot ID (a plain
# number, e.g. 1234567890) here. Until this is set, the reward flow still
# works end-to-end (real countdown, real key granted) just without an
# actual ad filling the space.
EXPO_PUBLIC_ADSENSE_REWARD_SLOT_ID=2976520224


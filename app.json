{
  "expo": {
    "name": "PataSkills",
    "slug": "play",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/9dabfd14-f5c7-4004-a38b-9d795c406e0f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pataskillsplay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pataskills.v2"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "image": "./assets/images/icon-dark.png",
            "backgroundColor": "#161616"
          }
        }
      ],
      "./plugins/withDarkWindowBackground.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dabfd14-f5c7-4004-a38b-9d795c406e0f"
      }
    },
    "owner": "tonymkay"
  }
}

{
  "expo": {
    "name": "PataSkills",
    "slug": "play",
    "version": "1.0.0",
    "runtimeVersion": "1.0.2",
    "updates": {
      "url": "https://u.expo.dev/9dabfd14-f5c7-4004-a38b-9d795c406e0f"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pataskillsplay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pataskills.v2"
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "image": "./assets/images/icon-dark.png",
            "backgroundColor": "#161616"
          }
        }
      ],
      "./plugins/withDarkWindowBackground.js",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5256043046254310~1061696579",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class io.invertase.googlemobileads.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep class com.google.android.gms.ads.identifier.** { *; }\n-keep class com.revenuecat.purchases.** { *; }\n-keep class com.google.android.gms.auth.** { *; }\n-keep class com.reactnativegooglesignin.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keepclassmembers class * { @com.facebook.react.bridge.ReactMethod *; }"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9dabfd14-f5c7-4004-a38b-9d795c406e0f"
      }
    },
    "owner": "tonymkay"
  }
}
